{
  "name": "interview-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:up": "docker compose up -d --wait",
    "dev:down": "docker compose down",
    "dev:reset": "docker compose down -v && docker compose up -d --wait && pnpm db:migrate && pnpm search:init",
    "dev:logs": "docker compose logs -f",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:backfill": "tsx scripts/backfill-jobs.ts",
    "db:studio": "drizzle-kit studio",
    "search:init": "tsx scripts/search-reindex.ts",
    "search:reindex": "tsx scripts/search-reindex.ts --recreate",
    "workers:build": "tsx scripts/build-workers.ts",
    "check:local": "tsx scripts/check-local.ts",
    "check:adapters": "tsx scripts/check-adapters.ts",
    "seed:sources": "tsx scripts/seed-sources.ts",
    "ingest:dispatch": "tsx scripts/run-worker-local.ts dispatch",
    "ingest:drain": "tsx scripts/run-worker-local.ts drain",
    "sweep": "tsx scripts/run-worker-local.ts sweep"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@aws-sdk/client-s3": "^3.1130.0",
    "@aws-sdk/client-sfn": "^3.1130.0",
    "@aws-sdk/client-sqs": "^3.1130.0",
    "@aws-sdk/s3-request-presigner": "^3.1130.0",
    "@clerk/nextjs": "^7.9.2",
    "@neondatabase/serverless": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.45.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "svix": "^2.4.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.22.0"
}
